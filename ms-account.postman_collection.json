{
  "info": {
    "_postman_id": "a2b3c4d5-e6f7-4a8b-9c0d-1e2f3a4b5c6d",
    "name": "Pivot Banking - ms-account (Phase II)",
    "description": "Complete Postman Collection for pivot-ms-account covering Phase I & Phase II rules (VIP/PYME active credit card verification against ms-credit, minimum opening amount validation, and automatic commission fee after exceeding free monthly transactions).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Open Personal SAVINGS Account (201 Created - Unmasked Once)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"accountId\", jsonData.id);",
              "    pm.collectionVariables.set(\"accountNumber\", jsonData.accountNumber);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{personalCustomerId}}\",\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"PEN\",\n  \"balance\": 500.00,\n  \"maxFreeMonthlyTransactions\": 2,\n  \"transactionCommissionFee\": 5.00\n}"
        },
        "url": {
          "raw": "{{urlMsAccount}}/accounts",
          "host": [
            "{{urlMsAccount}}"
          ],
          "path": [
            "accounts"
          ]
        }
      }
    },
    {
      "name": "2. [Error 400] Open Account Below Minimum Opening Amount (Phase II)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 400 Bad Request\", function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{personalCustomerId}}\",\n  \"accountType\": \"FIXED_TERM\",\n  \"currency\": \"PEN\",\n  \"balance\": 50.00,\n  \"minOpeningAmount\": 200.00\n}"
        },
        "url": {
          "raw": "{{urlMsAccount}}/accounts",
          "host": [
            "{{urlMsAccount}}"
          ],
          "path": [
            "accounts"
          ]
        }
      }
    },
    {
      "name": "3. Open Business CHECKING Account with Holders & Signers (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"checkingAccountId\", jsonData.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{businessCustomerId}}\",\n  \"accountType\": \"CHECKING\",\n  \"currency\": \"PEN\",\n  \"balance\": 10000.00,\n  \"holders\": [\n    \"20556677889\",\n    \"71234567\"\n  ],\n  \"authorizedSigners\": [\n    \"44556677\"\n  ]\n}"
        },
        "url": {
          "raw": "{{urlMsAccount}}/accounts",
          "host": [
            "{{urlMsAccount}}"
          ],
          "path": [
            "accounts"
          ]
        }
      }
    },
    {
      "name": "4. Get Account by Account Number (SHA-256 Blind Index Lookup)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{urlMsAccount}}/accounts/number/{{accountNumber}}",
          "host": [
            "{{urlMsAccount}}"
          ],
          "path": [
            "accounts",
            "number",
            "{{accountNumber}}"
          ]
        }
      }
    },
    {
      "name": "5. Free Movement #1 - Deposit 100.00 (lastAppliedCommission == 0.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Commission is 0.00 within free limit\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().lastAppliedCommission).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationType\": \"DEPOSIT\",\n  \"amount\": 100.00\n}"
        },
        "url": {
          "raw": "{{urlMsAccount}}/accounts/{{accountId}}/balance",
          "host": [
            "{{urlMsAccount}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        }
      }
    },
    {
      "name": "6. Free Movement #2 - Withdrawal 50.00 (lastAppliedCommission == 0.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Commission is 0.00 on 2nd free movement\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().lastAppliedCommission).to.eql(0);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationType\": \"WITHDRAWAL\",\n  \"amount\": 50.00\n}"
        },
        "url": {
          "raw": "{{urlMsAccount}}/accounts/{{accountId}}/balance",
          "host": [
            "{{urlMsAccount}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        }
      }
    },
    {
      "name": "7. Movement #3 Exceeding Free Limit - Automatic Commission Charged (lastAppliedCommission == 5.00)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Automatic commission of 5.00 is applied after exceeding free limit\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().lastAppliedCommission).to.eql(5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationType\": \"DEPOSIT\",\n  \"amount\": 100.00\n}"
        },
        "url": {
          "raw": "{{urlMsAccount}}/accounts/{{accountId}}/balance",
          "host": [
            "{{urlMsAccount}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        }
      }
    },
    {
      "name": "8. Consult Available Balance (GET /accounts/{id}/balance)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{urlMsAccount}}/accounts/{{accountId}}/balance",
          "host": [
            "{{urlMsAccount}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        }
      }
    }
  ],
