{
  "info": {
    "_postman_id": "a2b3c4d5-e6f7-4a8b-9c0d-1e2f3a4b5c6d",
    "name": "Pivot Banking - ms-account (Phase III)",
    "description": "Postman Collection for pivot-ms-account (Phase III): accounts, automatic commission, debit cards, cascading payments (primary → secondary accounts), and account lifecycle. Yanki settlement is Kafka-only: this service consumes yanki.payment.requested and publishes yanki.payment.result, there is no REST endpoint for it. Prerequisite: run ms-customer first and set personalCustomerId / businessCustomerId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Open Personal SAVINGS Account (201 Created - Unmasked Once)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"accountId\", jsonData.id);",
              "    pm.collectionVariables.set(\"accountNumber\", jsonData.accountNumber);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{personalCustomerId}}\",\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"PEN\",\n  \"balance\": 500.00,\n  \"maxFreeMonthlyTransactions\": 2,\n  \"transactionCommissionFee\": 5.00\n}"
        },
        "url": {
          "raw": "{{urlMsAccount}}/accounts",
          "host": [
            "{{urlMsAccount}}"
          ],
          "path": [
            "accounts"
          ]
        }
      }
    },
