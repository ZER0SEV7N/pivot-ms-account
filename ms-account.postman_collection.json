            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200 OK\", function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "pm.test(\"The payment was split across primary and secondary accounts\", function () {",
              "    pm.expect(jsonData.debitedAccounts.length).to.be.at.least(2);",
              "});"
