{
  "info": {
    "_postman_id": "b2c3d4e5-f6a7-4b5c-9d0e-1f2a3b4c5d6e",
    "name": "Pivot Banking - ms-account",
    "description": "Complete Postman Collection for pivot-ms-account (Passive Products, Strategy Rules, AES-256-GCM, SHA-256 Blind Index, Balance Updates, Soft Delete).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Open Personal SAVINGS Account (201 Created)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "if (jsonData.id) {",
              "    pm.collectionVariables.set(\"accountId\", jsonData.id);",
              "    pm.collectionVariables.set(\"accountNumber\", jsonData.accountNumber);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{personalCustomerId}}\",\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"PEN\",\n  \"balance\": 500.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts"
          ]
        }
      }
    },
    {
      "name": "2. [Error 400] Personal Customer Trying 2nd SAVINGS Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{personalCustomerId}}\",\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"PEN\",\n  \"balance\": 100.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts"
          ]
        }
      }
    },
    {
      "name": "3. Open Business CHECKING Account with Holders & Signers (201 Created)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{businessCustomerId}}\",\n  \"accountType\": \"CHECKING\",\n  \"currency\": \"PEN\",\n  \"balance\": 10000.00,\n  \"holders\": [\n    \"20556677889\",\n    \"71234567\"\n  ],\n  \"authorizedSigners\": [\n    \"44556677\"\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts"
          ]
        }
      }
    },
    {
      "name": "4. [Error 400] Business Customer Trying SAVINGS Account",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{businessCustomerId}}\",\n  \"accountType\": \"SAVINGS\",\n  \"currency\": \"PEN\",\n  \"balance\": 5000.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts"
          ]
        }
      }
    },
    {
      "name": "5. Get Account by Account Number (SHA-256 Blind Index Lookup)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/number/{{accountNumber}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "number",
            "{{accountNumber}}"
          ]
        }
      }
    },
    {
      "name": "6. Consult Available Balance (GET /balance)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        }
      }
    },
    {
      "name": "7. [Error 400] Try Soft Delete While Balance > 0",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}"
          ]
        }
      }
    },
    {
      "name": "8. Withdraw Full Balance to 0.00 (PATCH /balance)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"operationType\": \"WITHDRAWAL\",\n  \"amount\": 500.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        }
      }
    },
    {
      "name": "9. Soft Delete (Close) Account with Balance == 0 (204 No Content)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "accounts",
            "{{accountId}}"
          ]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082/api/v1",
      "type": "string"
    },
    {
      "key": "personalCustomerId",
      "value": "PASTE_YOUR_PERSONAL_CUSTOMER_ID_HERE",
      "type": "string"
    },
    {
      "key": "businessCustomerId",
      "value": "PASTE_YOUR_BUSINESS_CUSTOMER_ID_HERE",
      "type": "string"
    },
    {
      "key": "accountId",
      "value": "",
      "type": "string"
    },
    {
      "key": "accountNumber",
      "value": "",
      "type": "string"
    }
  ]
}