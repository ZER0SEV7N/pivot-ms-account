        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class BankAccount {\n        &lt;&lt;Java Class&gt;&gt;\n        -String id\n        -String accountNumber\n        -String customerId\n        -BigDecimal balance\n        -String currency\n        -BigDecimal maintenanceFee\n        -Integer maxMonthlyMovements\n        -Integer currentMonthlyMovements\n        -Integer freeTransactionsLimit\n        -BigDecimal extraTransactionFee\n        -Instant createdAt\n        -Instant updatedAt\n        +BankAccount()\n        +getId() String\n        +getAccountNumber() String\n        +getBalance() BigDecimal\n        +setBalance(BigDecimal) void\n        +validateAccountRules() boolean\n    }\n\n    class SavingsAccount {\n        &lt;&lt;Java Class&gt;&gt;\n        -BigDecimal minimumDailyAverage\n        +SavingsAccount()\n        +hasRemainingMonthlyMovements() boolean\n    }\n\n    class CheckingAccount {\n        &lt;&lt;Java Class&gt;&gt;\n        -List~String~ holders\n        -List~String~ authorizedSigners\n        +CheckingAccount()\n        +getHolders() List~String~\n        +getAuthorizedSigners() List~String~\n        +validateMinimumOneHolder() boolean\n    }\n\n    class FixedTermAccount {\n        &lt;&lt;Java Class&gt;&gt;\n        -Integer allowedMovementDay\n        +FixedTermAccount()\n        +getAllowedMovementDay() Integer\n        +canMoveOnDay(int dayOfMonth) boolean\n    }\n\n    class AccountType {\n        &lt;&lt;enumeration&gt;&gt;\n        SAVINGS\n        CHECKING\n        FIXED_TERM\n    }\n\n    class AccountStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        ACTIVE\n        BLOCKED\n        CLOSED\n    }\n\n    class CustomerSummary {\n        &lt;&lt;External DTO&gt;&gt;\n        -String id\n        -String customerType\n        -String profile\n        -String status\n    }\n\n    %% Herencia de tipos de cuenta bancaria\n    BankAccount &lt;|-- SavingsAccount : inherits from\n    BankAccount &lt;|-- CheckingAccount : inherits from\n    BankAccount &lt;|-- FixedTermAccount : inherits from\n\n    %% Asociaciones y Multiplicidades\n    CustomerSummary \&quot;1\&quot; --&gt; \&quot;0..*\&quot; BankAccount : owns &gt;\n    BankAccount \&quot;0..*\&quot; --&gt; \&quot;1\&quot; AccountType : classified as\n    BankAccount \&quot;0..*\&quot; --&gt; \&quot;1\&quot; AccountStatus : has state&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="gCsvmLlX194Ay5MaSAhm-1">
